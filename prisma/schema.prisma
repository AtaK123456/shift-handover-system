// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  importFileExtension = "js"
  previewFeatures = ["partialIndexes"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  SUPERVISOR
  WORKER
}

enum ShiftStatus {
  ACTIVE
  COMPLETED
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  name       String
  password   String
  role       Role       @default(WORKER)
  createdAt  DateTime   @default(now())
  shifts     Shift[]
  logs       Log[]
  operationEntries OperationEntry[] @relation("EntryAuthor")
  operationUpdates OperationUpdate[]
  closedEntries OperationEntry[] @relation("EntryCloser")
  equipmentUpdates Equipment[]
  equipmentChanges EquipmentChange[]
  readReceipts HandoverRead[]
  handoversFrom Handover[] @relation("HandoverFrom")
  handoversTo   Handover[] @relation("HandoverTo")
}

model Shift {
  id         Int        @id @default(autoincrement())
  startTime  DateTime   @default(now())
  endTime    DateTime?
  status     ShiftStatus @default(ACTIVE)
  userId     Int
  user       User       @relation(fields: [userId], references: [id])
  logs       Log[]
  handovers  Handover[]
  reports    Report[]
  operationEntries OperationEntry[]
  readReceipts HandoverRead[]
  shiftDate String?
  scheduledStart String?
  scheduledEnd String?
  createdAt  DateTime   @default(now())

  @@unique([userId], map: "Shift_one_active_per_user", where: raw("(status = 'ACTIVE'::\"ShiftStatus\")"))
}

model Handover {
  id          Int      @id @default(autoincrement())
  shiftId     Int
  shift       Shift    @relation(fields: [shiftId], references: [id])
  fromUserId  Int
  fromUser    User     @relation("HandoverFrom", fields: [fromUserId], references: [id])
  toUserId    Int
  toUser      User     @relation("HandoverTo", fields: [toUserId], references: [id])
  notes       String
  createdAt   DateTime @default(now())
}

model Log {
  id          Int      @id @default(autoincrement())
  shiftId     Int
  shift       Shift    @relation(fields: [shiftId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  category    String
  description String
  createdAt   DateTime @default(now())
}

model Report {
  id          Int      @id @default(autoincrement())
  shiftId     Int
  shift       Shift    @relation(fields: [shiftId], references: [id])
  summary     String
  generatedAt DateTime @default(now())
}

enum EquipmentStatus {
  UNKNOWN
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum EntryKind {
  EVENT
  NOTE
  VALVE
  ATTENTION
  TASK
}

enum EntryPriority {
  NORMAL
  HIGH
}

model Equipment {
  code String @id
  name String @default("")
  status EquipmentStatus @default(UNKNOWN)
  note String @default("")
  version Int @default(0)
  updatedAt DateTime?
  updatedById Int?
  updatedBy User? @relation(fields: [updatedById], references: [id])
  changes EquipmentChange[]
  entries OperationEntry[]
}

model EquipmentChange {
  id Int @id @default(autoincrement())
  equipmentCode String
  equipment Equipment @relation(fields: [equipmentCode], references: [code])
  fromStatus EquipmentStatus
  toStatus EquipmentStatus
  note String
  userId Int
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model OperationEntry {
  id Int @id @default(autoincrement())
  kind EntryKind
  priority EntryPriority @default(NORMAL)
  title String
  description String
  createdAt DateTime @default(now())
  authorId Int
  author User @relation("EntryAuthor", fields: [authorId], references: [id])
  shiftId Int?
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  closedAt DateTime?
  closedById Int?
  closedBy User? @relation("EntryCloser", fields: [closedById], references: [id])
  closeNote String?
  photos OperationPhoto[]
  updates OperationUpdate[]
  equipmentCode String?
  equipment Equipment? @relation(fields: [equipmentCode], references: [code])
  @@index([equipmentCode, createdAt])
  @@index([closedAt, kind, createdAt])
}

model OperationPhoto {
  id String @id @default(uuid())
  entryId Int
  entry OperationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  data Bytes
  createdAt DateTime @default(now())
}


model OperationRevision {
  id Int @id
  version Int @default(0)
}

model HandoverRead {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [id])
  shiftId Int
  shift Shift @relation(fields: [shiftId], references: [id])
  revision Int
  readAt DateTime @default(now())
  snapshot Json
  @@unique([userId, shiftId, revision])
}

model OperationUpdate {
  id Int @id @default(autoincrement())
  entryId Int
  entry OperationEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId Int
  author User @relation(fields: [authorId], references: [id])
  body String @db.VarChar(2000)
  requestId String @db.Uuid
  createdAt DateTime @default(now())
  @@unique([authorId, requestId])
  @@index([entryId, createdAt, id])
}
